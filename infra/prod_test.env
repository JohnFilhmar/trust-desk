# Made-up values for running the PRODUCTION images on a development machine.
# EVERY VALUE HERE PROTECTS NOTHING. Never copy this file to the server.
#
#   docker compose --env-file infra/prod_test.env \
#     -f docker-compose.prod.yml -f docker-compose.prod-test.yml up --build -d
#
# The real env file is created by hand on the server. See docs/env-reference.md.

IMAGE_PREFIX=local
IMAGE_TAG=prodtest

MYSQL_ROOT_PASSWORD=dev-only-root-not-a-secret
DB_NAME=trust_desk_production
DB_TEST_NAME=trust_desk_test
DB_ADMIN_USERNAME=td_admin
DB_ADMIN_PASSWORD=dev-only-admin-not-a-secret
DB_CORE_API_USERNAME=td_core_api
DB_CORE_API_PASSWORD=dev-only-core-api-not-a-secret
DB_HANDLERS_USERNAME=td_handlers
DB_HANDLERS_PASSWORD=dev-only-handlers-not-a-secret

SECRET_KEY_BASE=dev-only-key-base-not-a-secret-0123456789abcdef0123456789abcdef
SERVICE_HMAC_SECRET=dev-only-hmac-not-a-secret-0123456789abcdef
SESSION_SECRET=dev-only-session-not-a-secret-0123456789abcdef
APP_ORIGINS=http://localhost:18080
