{
  "name": "@trust-desk/handlers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.cjs --runInBand"
  },
  "dependencies": {
    "@trust-desk/shared": "workspace:*",
    "bcryptjs": "3.0.3",
    "mysql2": "3.24.4",
    "pino": "10.3.1",
    "zod": "4.6.5"
  }
}
