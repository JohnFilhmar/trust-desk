{
  "name": "trust-desk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "test:integration": "pnpm --filter @trust-desk/handlers run test:integration",
    "build": "pnpm --filter @trust-desk/web run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@swc/core": "1.16.2",
    "@swc/jest": "0.2.39",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "eslint-plugin-jsdoc": "64.5.4",
    "jest": "30.5.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  }
}
